(filecon "/run/rocky-eng(/.*)?" any (system_u object_r engbox_worker_run_t ((s0) (s0))))

; Broker-only revision: inherited default labels are not execution authority.
; Strip transition grants to EVERY type except the required Podman runtime.
; No other source domain's permissions are removed or granted.
(typeattribute engbox_worker_non_engine_targets)
(typeattributeset engbox_worker_non_engine_targets (not (container_runtime_t)))
(deny engbox_worker_t engbox_worker_non_engine_targets (process (transition)))
(neverallow engbox_worker_t engbox_worker_non_engine_targets (process (transition)))
; Block the observed ABRT entrypoint as well as its process transition.
(deny engbox_worker_t abrt_helper_exec_t (file (execute execute_no_trans entrypoint)))
(neverallow engbox_worker_t abrt_helper_exec_t (file (execute execute_no_trans entrypoint)))
; The broker cannot opt into another process/exec context explicitly.
(deny engbox_worker_t self (process (setexec setcurrent dyntransition)))
(neverallow engbox_worker_t self (process (setexec setcurrent dyntransition)))

; Traverse/stat the existing private .local parent; no listing or write.
(allow engbox_worker_t gconf_home_t (dir (getattr search)))
